#include <windows.h>
#include "resource.h"

IDI_VO_APP      ICON    "../assets/vointel.ico"
IDR_XAML_LAYOUT RCDATA  "ui/AppLayout.xaml"
IDR_PNG_LOGO    RCDATA  "../assets/logo_ui.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Vortex Open Source Project"
            VALUE "FileDescription",  "VOverclock Intel Beta - CPU Tuner & Core Monitor"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "VOverclockIntel.exe"
            VALUE "LegalCopyright",   "Vortex Open Source Project"
            VALUE "OriginalFilename", "VOverclockIntel.exe"
            VALUE "ProductName",      "VOverclock Intel Beta"
            VALUE "ProductVersion",   "Beta"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
