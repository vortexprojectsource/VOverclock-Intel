<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light"
    Background="#FFFFFF">

    <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#2563EB" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#1E40AF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#94A3B8" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#09090B" />

                    <SolidColorBrush x:Key="SliderTrackFill" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#2563EB" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#1E40AF" />
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#09090B" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#2563EB" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#1D4ED8" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CompactSliderStyle" TargetType="Slider">
                <Setter Property="Foreground" Value="#2563EB" />
                <Setter Property="Background" Value="#E2E8F0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="IsThumbToolTipEnabled" Value="False" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="ManipulationMode" Value="None" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Margin="{TemplateBinding Padding}" Height="20">
                                <Grid.Resources>
                                    <Style TargetType="Thumb" x:Key="SleekThumbStyle">
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Background" Value="#09090B" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbRing"
                                                            Width="14"
                                                            Height="14"
                                                            CornerRadius="7"
                                                            Background="#FFFFFF"
                                                            BorderBrush="{TemplateBinding Background}"
                                                            BorderThickness="2.5"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform><ScaleTransform x:Name="ThumbScale" /></Border.RenderTransform>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Grid.Resources>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HorizontalTrackRect" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#CBD5E1" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HorizontalDecreaseRect" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#1D4ED8" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HorizontalThumb" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#2563EB" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HorizontalDecreaseRect" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#1E40AF" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HorizontalThumb" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#1D4ED8" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SliderContainer" Storyboard.TargetProperty="Opacity" To="0.40" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid x:Name="SliderContainer" Background="Transparent" Control.IsTemplateFocusTarget="True">
                                    <Grid x:Name="HorizontalTemplate" Height="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Rectangle x:Name="HorizontalTrackRect"
                                                   Fill="{TemplateBinding Background}"
                                                   Height="4"
                                                   RadiusX="2"
                                                   RadiusY="2"
                                                   Grid.Row="1"
                                                   Grid.ColumnSpan="3" />
                                        <Rectangle x:Name="HorizontalDecreaseRect"
                                                   Fill="{TemplateBinding Foreground}"
                                                   Height="4"
                                                   RadiusX="2"
                                                   RadiusY="2"
                                                   Grid.Row="1" />
                                        <TickBar x:Name="TopTickBar" Visibility="Collapsed" />
                                        <TickBar x:Name="HorizontalInlineTickBar" Visibility="Collapsed" />
                                        <TickBar x:Name="BottomTickBar" Visibility="Collapsed" />
                                        <Thumb x:Name="HorizontalThumb"
                                               Style="{StaticResource SleekThumbStyle}"
                                               DataContext="{TemplateBinding Value}"
                                               Height="14"
                                               Width="14"
                                               Grid.Row="0"
                                               Grid.RowSpan="3"
                                               Grid.Column="1"
                                               AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                    <Grid x:Name="VerticalTemplate" Visibility="Collapsed">
                                        <Rectangle x:Name="VerticalTrackRect" />
                                        <Rectangle x:Name="VerticalDecreaseRect" />
                                        <TickBar x:Name="LeftTickBar" Visibility="Collapsed" />
                                        <TickBar x:Name="VerticalInlineTickBar" Visibility="Collapsed" />
                                        <TickBar x:Name="RightTickBar" Visibility="Collapsed" />
                                        <Thumb x:Name="VerticalThumb" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ToggleSwitch">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="Width" Value="40" />
                <Setter Property="ManipulationMode" Value="System,TranslateX" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleSwitch">
                            <Grid Background="Transparent" Height="24" Width="40">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="0.90" Duration="0:0:0.06" />
                                                <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="0.90" Duration="0:0:0.06" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SwitchAreaGrid" Storyboard.TargetProperty="Opacity" To="0.40" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="ToggleStates">
                                        <VisualState x:Name="Dragging" />
                                        <VisualState x:Name="Off">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                                <DoubleAnimation Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                                <DoubleAnimation Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="On">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                                <DoubleAnimation Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                                <DoubleAnimation Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid x:Name="SwitchAreaGrid" Width="40" Height="22" VerticalAlignment="Center" Control.IsTemplateFocusTarget="True" Background="Transparent">
                                    <Rectangle x:Name="OuterBorder" Width="40" Height="22" RadiusX="11" RadiusY="11" Fill="#E2E8F0" Stroke="#CBD5E1" StrokeThickness="1" />
                                    <Rectangle x:Name="SwitchKnobBounds" Width="40" Height="22" RadiusX="11" RadiusY="11" Fill="#2563EB" Opacity="0" />
                                    <Grid x:Name="SwitchKnob" Width="22" Height="22" HorizontalAlignment="Left">
                                        <Grid.RenderTransform><TranslateTransform x:Name="KnobTranslateTransform" /></Grid.RenderTransform>
                                        <Grid Width="16" Height="16" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid.RenderTransform><ScaleTransform x:Name="KnobScale" /></Grid.RenderTransform>
                                            <Ellipse x:Name="SwitchKnobOff" Fill="#09090B" Width="14" Height="14" />
                                            <Ellipse x:Name="SwitchKnobOn" Fill="#FFFFFF" Width="16" Height="16" Opacity="0" />
                                        </Grid>
                                    </Grid>
                                    <Thumb x:Name="SwitchThumb" Width="40" Height="22">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent" /></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryBlueButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#2563EB" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#1D4ED8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="11,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><CompositeTransform x:Name="BtnTransform" /></Border.RenderTransform>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10" />
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08" />
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleX" To="1.012" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleY" To="1.012" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.05" />
                                                <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05" />
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06" />
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard><DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" /></Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid>
                                    <Border x:Name="HoverOverlay" Background="#1D4ED8" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                    <Border x:Name="PressOverlay" Background="#1E40AF" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryBlackButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#09090B" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#09090B" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="11,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><CompositeTransform x:Name="BtnTransform" /></Border.RenderTransform>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10" />
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.14" />
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.14" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleX" To="1.012" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleY" To="1.012" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06" />
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard><DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" /></Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid>
                                    <Border x:Name="HoverOverlay" Background="#1E293B" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                    <Border x:Name="PressOverlay" Background="#334155" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryOutlineButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#09090B" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><CompositeTransform x:Name="BtnTransform" /></Border.RenderTransform>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.06" />
                                                <DoubleAnimation Storyboard.TargetName="BtnTransform" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.06" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard><DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" /></Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid>
                                    <Border x:Name="HoverBg" Background="#EFF6FF" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MinimalIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><CompositeTransform x:Name="IconTransform" /></Border.RenderTransform>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                                <DoubleAnimation Storyboard.TargetName="IconTransform" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="IconTransform" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                                                <DoubleAnimation Storyboard.TargetName="IconTransform" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="IconTransform" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="IconTransform" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.06" />
                                                <DoubleAnimation Storyboard.TargetName="IconTransform" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.06" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid>
                                    <Border x:Name="HoverBg" Background="#F1F5F9" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseWindowButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><CompositeTransform x:Name="CloseTransform" /></Border.RenderTransform>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                                <DoubleAnimation Storyboard.TargetName="CloseTransform" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="CloseTransform" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                                                <DoubleAnimation Storyboard.TargetName="CloseTransform" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="CloseTransform" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CloseTransform" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.06" />
                                                <DoubleAnimation Storyboard.TargetName="CloseTransform" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.06" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid>
                                    <Border x:Name="HoverBg" Background="#FEE2E2" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PillOptionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#475569" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="9,3" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PillRoot" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><CompositeTransform x:Name="PillTransform" /></Border.RenderTransform>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PillTransform" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="PillTransform" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PillTransform" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.10" />
                                                <DoubleAnimation Storyboard.TargetName="PillTransform" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.10" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PillTransform" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="0:0:0.06" />
                                                <DoubleAnimation Storyboard.TargetName="PillTransform" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="0:0:0.06" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PlanPopupItemButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#09090B" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><CompositeTransform x:Name="ItemTransform" /></Border.RenderTransform>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverTint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="ItemTransform" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.10" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverTint" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09" />
                                                <DoubleAnimation Storyboard.TargetName="ItemTransform" Storyboard.TargetProperty="ScaleX" To="1.008" Duration="0:0:0.10" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ItemTransform" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0:0:0.05" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid>
                                    <Border x:Name="HoverTint" Background="#F1F5F9" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Storyboard x:Name="GearSpinInStoryboard">
                <DoubleAnimation Storyboard.TargetName="GearTransform" Storyboard.TargetProperty="Rotation" To="45" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Name="GearSpinOutStoryboard">
                <DoubleAnimation Storyboard.TargetName="GearTransform" Storyboard.TargetProperty="Rotation" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Name="OpenSettingsStoryboard">
                <DoubleAnimation Storyboard.TargetName="SettingsTransform" Storyboard.TargetProperty="TranslateX" From="28" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="SettingsView" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.20" />
            </Storyboard>
            <Storyboard x:Name="OpenMainStoryboard">
                <DoubleAnimation Storyboard.TargetName="MainTransform" Storyboard.TargetProperty="TranslateX" From="-28" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="MainView" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.20" />
            </Storyboard>

            <Storyboard x:Name="DashboardEntranceStoryboard">
                <DoubleAnimation Storyboard.TargetName="TopControlStripTransform" Storyboard.TargetProperty="Y" From="8" To="0" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="TopControlStrip" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                <DoubleAnimation Storyboard.TargetName="KpiStripTransform" Storyboard.TargetProperty="Y" From="10" To="0" BeginTime="0:0:0.04" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="KpiStripGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.04" Duration="0:0:0.22" />
                <DoubleAnimation Storyboard.TargetName="LeftPaneTransform" Storyboard.TargetProperty="Y" From="12" To="0" BeginTime="0:0:0.08" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="LeftControlBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.08" Duration="0:0:0.24" />
                <DoubleAnimation Storyboard.TargetName="RightPaneTransform" Storyboard.TargetProperty="Y" From="12" To="0" BeginTime="0:0:0.11" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="RightCoreBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.11" Duration="0:0:0.24" />
            </Storyboard>

            <Storyboard x:Name="LiveDotPulseStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="LiveDotScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="1.45" AutoReverse="True" Duration="0:0:0.85" />
                <DoubleAnimation Storyboard.TargetName="LiveDotScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="1.45" AutoReverse="True" Duration="0:0:0.85" />
                <DoubleAnimation Storyboard.TargetName="LiveTelemetryPulseDot" Storyboard.TargetProperty="Opacity" From="1.0" To="0.45" AutoReverse="True" Duration="0:0:0.85" />
            </Storyboard>

            <Storyboard x:Name="LeftTabSwitchStoryboard">
                <DoubleAnimation Storyboard.TargetName="LeftPageHostTransform" Storyboard.TargetProperty="Y" From="7" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="LeftPageHost" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.16" />
            </Storyboard>

            <Storyboard x:Name="CoreFilterSlideStoryboard">
                <DoubleAnimation Storyboard.TargetName="CoreGridTransform" Storyboard.TargetProperty="Y" From="8" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="CoreGraphsContainer" Storyboard.TargetProperty="Opacity" From="0.45" To="1" Duration="0:0:0.18" />
            </Storyboard>

            <Storyboard x:Name="PowerPlanOpenStoryboard">
                <DoubleAnimation Storyboard.TargetName="PowerPlanPopupTransform" Storyboard.TargetProperty="TranslateY" From="-8" To="0" Duration="0:0:0.18">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="PowerPlanPopupTransform" Storyboard.TargetProperty="ScaleY" From="0.95" To="1" Duration="0:0:0.18">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="PowerPlanPopupBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                <DoubleAnimation Storyboard.TargetName="PlanChevronTransform" Storyboard.TargetProperty="Rotation" To="180" Duration="0:0:0.18">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Name="PowerPlanCloseStoryboard">
                <DoubleAnimation Storyboard.TargetName="PowerPlanPopupTransform" Storyboard.TargetProperty="TranslateY" To="-6" Duration="0:0:0.12" />
                <DoubleAnimation Storyboard.TargetName="PowerPlanPopupBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                <DoubleAnimation Storyboard.TargetName="PlanChevronTransform" Storyboard.TargetProperty="Rotation" To="0" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Name="RunningProcOpenStoryboard">
                <DoubleAnimation Storyboard.TargetName="RunningProcPopupTransform" Storyboard.TargetProperty="TranslateY" From="-8" To="0" Duration="0:0:0.18">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="RunningProcPopupBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
            </Storyboard>

            <Storyboard x:Name="StatusPopStoryboard">
                <DoubleAnimation Storyboard.TargetName="ActionStatusTransform" Storyboard.TargetProperty="Y" From="5" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="ActionStatusText" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
            </Storyboard>
        </ResourceDictionary>
    </Grid.Resources>

    <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="1" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- KEPT HEADER (UNCHANGED DESIGN) -->
    <Grid Grid.Row="0" Background="#FFFFFF" Padding="14,0,10,0">
        <Grid x:Name="TitleBarDragArea" Background="#01FFFFFF" />

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False">
            <Image x:Name="LogoImage" Height="22" Width="40" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="VOverclock Intel" FontSize="13.5" FontWeight="Bold" Foreground="#09090B" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="3">
            <Button x:Name="WinMinimizeButton" Style="{StaticResource MinimalIconButtonStyle}" Width="28" Height="28" ToolTipService.ToolTip="Minimize">
                <Viewbox Width="10" Height="10"><Canvas Width="24" Height="24"><Path Data="M5 12h14" Stroke="#0F172A" StrokeThickness="2.2" StrokeStartLineCap="Round" /></Canvas></Viewbox>
            </Button>
            <Button x:Name="WinCloseButton" Style="{StaticResource CloseWindowButtonStyle}" Width="28" Height="28" ToolTipService.ToolTip="Close">
                <Viewbox Width="10" Height="10"><Canvas Width="24" Height="24"><Path Data="M6 6l12 12 M18 6l-12 12" Stroke="#0F172A" StrokeThickness="2.2" StrokeStartLineCap="Round" /></Canvas></Viewbox>
            </Button>
        </StackPanel>
    </Grid>

    <Rectangle Grid.Row="1" Fill="#E2E8F0" />

    <!-- Main Cockpit -->
    <Grid x:Name="MainView" Grid.Row="2" Background="#FFFFFF" Padding="16,10,16,8" Visibility="Visible">
        <Grid.RenderTransform><CompositeTransform x:Name="MainTransform" /></Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- CPU Identity Left + Power Plan Switcher Right -->
        <Grid x:Name="TopControlStrip" Grid.Row="0" Margin="0,0,0,9">
            <Grid.RenderTransform><TranslateTransform x:Name="TopControlStripTransform" /></Grid.RenderTransform>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <TextBlock x:Name="CpuBrandText" Text="Detecting Processor..." FontSize="14.5" FontWeight="Bold" Foreground="#09090B" VerticalAlignment="Center" />
                <TextBlock x:Name="CpuSpecShortText" Text="--" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="Power Plan" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                <Button x:Name="CustomPlanSelectBtn"
                        Style="{StaticResource SecondaryOutlineButtonStyle}"
                        Width="220"
                        Height="28"
                        Padding="10,0"
                        HorizontalContentAlignment="Stretch">
                    <Grid>
                        <TextBlock x:Name="SelectedPlanLabelText" Text="Balanced" FontSize="11" FontWeight="SemiBold" Foreground="#09090B" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                        <Viewbox Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform><CompositeTransform x:Name="PlanChevronTransform" /></Viewbox.RenderTransform>
                            <Canvas Width="24" Height="24"><Path Data="M6 9l6 6 6-6" Stroke="#0F172A" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeLineJoin="Round" /></Canvas>
                        </Viewbox>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Clean Unified 4-Column Hairline CPU Stat Bar (ZERO RAM/MEMORY!) -->
        <Border x:Name="KpiStripGrid" Grid.Row="1" Margin="0,0,0,10" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="4,8">
            <Border.RenderTransform><TranslateTransform x:Name="KpiStripTransform" /></Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Padding="12,1">
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="AVG CLOCK" FontSize="9" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="KpiClockText" Text="0.00 GHz" FontSize="18" FontWeight="Bold" Foreground="#2563EB" />
                    </StackPanel>
                    <TextBlock x:Name="KpiClockSubText" Text="P 0.00 · E 0.00" FontSize="10" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>

                <Rectangle Grid.Column="1" Fill="#F1F5F9" Margin="0,2" />

                <Grid Grid.Column="2" Padding="12,1">
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="TURBO PEAK" FontSize="9" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="KpiPeakText" Text="0.00 GHz" FontSize="18" FontWeight="Bold" Foreground="#09090B" />
                    </StackPanel>
                    <TextBlock x:Name="KpiPeakSubText" Text="Max --" FontSize="10" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>

                <Rectangle Grid.Column="3" Fill="#F1F5F9" Margin="0,2" />

                <Grid Grid.Column="4" Padding="12,1">
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="CPU LOAD" FontSize="9" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="KpiLoadText" Text="0%" FontSize="18" FontWeight="Bold" Foreground="#09090B" />
                    </StackPanel>
                    <TextBlock x:Name="KpiLoadSubText" Text="P 0% · E 0%" FontSize="10" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>

                <Rectangle Grid.Column="5" Fill="#F1F5F9" Margin="0,2" />

                <Grid Grid.Column="6" Padding="12,1">
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="THERMAL · EPP" FontSize="9" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="KpiTempText" Text="N/A" FontSize="18" FontWeight="Bold" Foreground="#2563EB" />
                    </StackPanel>
                    <TextBlock x:Name="KpiBoostSubText" Text="EPP --" FontSize="10" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </Border>

        <!-- Clean Split Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="504" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE -->
            <Border x:Name="LeftControlBorder" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <Border.RenderTransform><TranslateTransform x:Name="LeftPaneTransform" /></Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Clean 4-Tab Bar + Clickable Live Switch -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" HorizontalAlignment="Left" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="2">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="LeftTabSlidersBtn" Style="{StaticResource PillOptionButtonStyle}" Padding="10,3.5" Content="Tuning" />
                                <Button x:Name="LeftTabAdvBtn" Style="{StaticResource PillOptionButtonStyle}" Padding="10,3.5" Content="Power Set" />
                                <Button x:Name="LeftTabTargetsBtn" Style="{StaticResource PillOptionButtonStyle}" Padding="10,3.5" Content="Apps Tweak" />
                                <Button x:Name="LeftTabCheckBtn" Style="{StaticResource PillOptionButtonStyle}" Padding="10,3.5" Content="Support" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="Live" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="ToggleLiveApply" OnContent="" OffContent="" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="LeftPageHost" Grid.Row="1">
                        <Grid.RenderTransform><TranslateTransform x:Name="LeftPageHostTransform" /></Grid.RenderTransform>

                        <!-- Page 1: Tuning -->
                        <Grid x:Name="LeftPageSliders" Visibility="Visible">
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="1" VerticalAlignment="Top">
                                    <Grid Padding="0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                                        <Grid Grid.Row="0"><TextBlock Text="Core Parking" FontSize="11" FontWeight="SemiBold" Foreground="#09090B" /><TextBlock x:Name="SldUnparkVal" Text="100%" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" /></Grid>
                                        <Slider x:Name="SliderUnpark" Grid.Row="1" Margin="0,-1,0,0" Style="{StaticResource CompactSliderStyle}" Minimum="0" Maximum="100" StepFrequency="5" SnapsTo="StepValues" Value="100" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="#F1F5F9" />
                                    <Grid Padding="0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                                        <Grid Grid.Row="0"><TextBlock Text="Minimum CPU State" FontSize="11" FontWeight="SemiBold" Foreground="#09090B" /><TextBlock x:Name="SldMinStateVal" Text="100%" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" /></Grid>
                                        <Slider x:Name="SliderMinState" Grid.Row="1" Margin="0,-1,0,0" Style="{StaticResource CompactSliderStyle}" Minimum="5" Maximum="100" StepFrequency="5" SnapsTo="StepValues" Value="100" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="#F1F5F9" />
                                    <Grid Padding="0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                                        <Grid Grid.Row="0"><TextBlock Text="Maximum CPU State" FontSize="11" FontWeight="SemiBold" Foreground="#09090B" /><TextBlock x:Name="SldMaxStateVal" Text="100%" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" /></Grid>
                                        <Slider x:Name="SliderMaxState" Grid.Row="1" Margin="0,-1,0,0" Style="{StaticResource CompactSliderStyle}" Minimum="20" Maximum="100" StepFrequency="5" SnapsTo="StepValues" Value="100" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="#F1F5F9" />
                                    <Grid Padding="0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                                        <Grid Grid.Row="0"><TextBlock Text="Turbo Boost Policy" FontSize="11" FontWeight="SemiBold" Foreground="#09090B" /><TextBlock x:Name="SldBoostPolVal" Text="100%" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" /></Grid>
                                        <Slider x:Name="SliderBoostPol" Grid.Row="1" Margin="0,-1,0,0" Style="{StaticResource CompactSliderStyle}" Minimum="0" Maximum="100" StepFrequency="5" SnapsTo="StepValues" Value="100" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="#F1F5F9" />
                                    <Grid Padding="0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                                        <Grid Grid.Row="0"><TextBlock Text="Speed Shift EPP" FontSize="11" FontWeight="SemiBold" Foreground="#09090B" /><TextBlock x:Name="SldEppVal" Text="0% Max" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" /></Grid>
                                        <Slider x:Name="SliderEpp" Grid.Row="1" Margin="0,-1,0,0" Style="{StaticResource CompactSliderStyle}" Minimum="0" Maximum="100" StepFrequency="5" SnapsTo="StepValues" Value="0" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="#F1F5F9" />
                                    <Grid Padding="0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                                        <Grid Grid.Row="0"><TextBlock Text="Frequency Limit" FontSize="11" FontWeight="SemiBold" Foreground="#09090B" /><TextBlock x:Name="SldFreqCapVal" Text="Uncapped" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" /></Grid>
                                        <Slider x:Name="SliderFreqCap" Grid.Row="1" Margin="0,-1,0,0" Style="{StaticResource CompactSliderStyle}" Minimum="0" Maximum="6600" StepFrequency="200" SnapsTo="StepValues" Value="0" />
                                    </Grid>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="8,3">
                                            <Grid>
                                                <TextBlock Text="Boost" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                                                    <Button x:Name="BoostPrevBtn" Style="{StaticResource MinimalIconButtonStyle}" Width="20" Height="20"><Viewbox Width="9" Height="9"><Canvas Width="24" Height="24"><Path Data="M15 18l-6-6 6-6" Stroke="#09090B" StrokeThickness="2.2" StrokeStartLineCap="Round" /></Canvas></Viewbox></Button>
                                                    <TextBlock x:Name="BoostValueText" Text="Eff. Aggr" Width="82" TextAlignment="Center" FontSize="10.5" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" />
                                                    <Button x:Name="BoostNextBtn" Style="{StaticResource MinimalIconButtonStyle}" Width="20" Height="20"><Viewbox Width="9" Height="9"><Canvas Width="24" Height="24"><Path Data="M9 18l6-6-6-6" Stroke="#09090B" StrokeThickness="2.2" StrokeStartLineCap="Round" /></Canvas></Viewbox></Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="8,3">
                                            <Grid>
                                                <TextBlock Text="Scheduler" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                                                    <Button x:Name="SchedPrevBtn" Style="{StaticResource MinimalIconButtonStyle}" Width="20" Height="20"><Viewbox Width="9" Height="9"><Canvas Width="24" Height="24"><Path Data="M15 18l-6-6 6-6" Stroke="#09090B" StrokeThickness="2.2" StrokeStartLineCap="Round" /></Canvas></Viewbox></Button>
                                                    <TextBlock x:Name="SchedValueText" Text="Prefer P-Core" Width="82" TextAlignment="Center" FontSize="10.5" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" />
                                                    <Button x:Name="SchedNextBtn" Style="{StaticResource MinimalIconButtonStyle}" Width="20" Height="20"><Viewbox Width="9" Height="9"><Canvas Width="24" Height="24"><Path Data="M9 18l6-6-6-6" Stroke="#09090B" StrokeThickness="2.2" StrokeStartLineCap="Round" /></Canvas></Viewbox></Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Page 2: Power Set -->
                        <Grid x:Name="LeftPageAdvanced" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="1" VerticalAlignment="Top">
                                    <Grid Padding="0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /></Grid.RowDefinitions>
                                        <Grid Grid.Row="0"><TextBlock Text="Boost Ramp Threshold" FontSize="11" FontWeight="SemiBold" Foreground="#09090B" /><TextBlock x:Name="SldIncThreshVal" Text="5%" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" /></Grid>
                                        <Slider x:Name="SliderIncThresh" Grid.Row="1" Margin="0,-1,0,0" Style="{StaticResource CompactSliderStyle}" Minimum="5" Maximum="100" StepFrequency="5" SnapsTo="StepValues" Value="5" />
                                    </Grid>
                                    <Grid Padding="0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /></Grid.RowDefinitions>
                                        <Grid Grid.Row="0"><TextBlock Text="Boost Hold Threshold" FontSize="11" FontWeight="SemiBold" Foreground="#09090B" /><TextBlock x:Name="SldDecThreshVal" Text="2%" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" /></Grid>
                                        <Slider x:Name="SliderDecThresh" Grid.Row="1" Margin="0,-1,0,0" Style="{StaticResource CompactSliderStyle}" Minimum="2" Maximum="100" StepFrequency="1" SnapsTo="StepValues" Value="2" />
                                    </Grid>
                                    <Grid Padding="0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /></Grid.RowDefinitions>
                                        <Grid Grid.Row="0"><TextBlock Text="P-Core Hetero Floor" FontSize="11" FontWeight="SemiBold" Foreground="#09090B" /><TextBlock x:Name="SldHeteroFloorVal" Text="100%" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" /></Grid>
                                        <Slider x:Name="SliderHeteroFloor" Grid.Row="1" Margin="0,-1,0,0" Style="{StaticResource CompactSliderStyle}" Minimum="0" Maximum="100" StepFrequency="5" SnapsTo="StepValues" Value="100" />
                                    </Grid>
                                    <Grid Padding="0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /></Grid.RowDefinitions>
                                        <Grid Grid.Row="0"><TextBlock Text="Parking Concurrency" FontSize="11" FontWeight="SemiBold" Foreground="#09090B" /><TextBlock x:Name="SldConcurVal" Text="20%" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" /></Grid>
                                        <Slider x:Name="SliderConcur" Grid.Row="1" Margin="0,-1,0,0" Style="{StaticResource CompactSliderStyle}" Minimum="5" Maximum="100" StepFrequency="5" SnapsTo="StepValues" Value="20" />
                                    </Grid>

                                    <Rectangle Height="1" Fill="#E2E8F0" Margin="0,3,0,2" />

                                    <Grid Height="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Active Cooling" FontSize="11" Foreground="#09090B" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="ToggleActiveCooling" Grid.Column="1" OnContent="" OffContent="" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="#F1F5F9" />
                                    <Grid Height="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="OS Direct Clock Control" FontSize="11" Foreground="#09090B" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="ToggleOsDirectHwp" Grid.Column="1" OnContent="" OffContent="" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="#F1F5F9" />
                                    <Grid Height="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Disable Idle C-States" FontSize="11" Foreground="#09090B" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="ToggleIdleDisable" Grid.Column="1" OnContent="" OffContent="" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="#F1F5F9" />
                                    <Grid Height="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="OS Scheduler Tweaks" FontSize="11" Foreground="#09090B" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="ToggleOsThrottle" Grid.Column="1" OnContent="" OffContent="" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="#F1F5F9" />
                                    <Grid Height="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="0.5ms Timer Resolution" FontSize="11" Foreground="#09090B" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="ToggleAdvHighRes" Grid.Column="1" OnContent="" OffContent="" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Page 3: Apps Tweak (.exe) -->
                        <Grid x:Name="LeftPageTargets" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button x:Name="BrowseExeBtn" Style="{StaticResource SecondaryOutlineButtonStyle}" Height="25" Padding="9,0">
                                        <TextBlock Text="Browse .exe" FontSize="10.5" FontWeight="SemiBold" Foreground="#09090B" />
                                    </Button>
                                    <Button x:Name="PickRunningExeBtn" Style="{StaticResource SecondaryOutlineButtonStyle}" Height="25" Padding="9,0">
                                        <TextBlock Text="Running Apps" FontSize="10.5" FontWeight="SemiBold" Foreground="#2563EB" />
                                    </Button>
                                </StackPanel>
                                <Button x:Name="ApplyTargetsBtn" HorizontalAlignment="Right" Style="{StaticResource PrimaryBlueButtonStyle}" Height="25" Padding="10,0">
                                    <TextBlock Text="Apply Apps" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                </Button>
                            </Grid>

                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="6">
                                <Grid>
                                    <ScrollViewer x:Name="TargetExeScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="TargetExeListPanel" Spacing="4" />
                                    </ScrollViewer>
                                    <TextBlock x:Name="TargetExeEmptyHint"
                                               Text="No apps added"
                                               FontSize="11"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="2" Spacing="1" Margin="0,6,0,0">
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Priority" FontSize="11" FontWeight="SemiBold" Foreground="#09090B" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" HorizontalAlignment="Right" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="2">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button x:Name="TargetPrio0Btn" Style="{StaticResource PillOptionButtonStyle}" Padding="7,2" Content="Normal" />
                                            <Button x:Name="TargetPrio1Btn" Style="{StaticResource PillOptionButtonStyle}" Padding="7,2" Content="Above" />
                                            <Button x:Name="TargetPrio2Btn" Style="{StaticResource PillOptionButtonStyle}" Padding="7,2" Content="High" />
                                            <Button x:Name="TargetPrio3Btn" Style="{StaticResource PillOptionButtonStyle}" Padding="7,2" Content="Realtime" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Rectangle Height="1" Fill="#F1F5F9" />
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Core Routing" FontSize="11" FontWeight="SemiBold" Foreground="#09090B" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" HorizontalAlignment="Right" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="2">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button x:Name="TargetCore0Btn" Style="{StaticResource PillOptionButtonStyle}" Padding="7,2" Content="All" />
                                            <Button x:Name="TargetCore1Btn" Style="{StaticResource PillOptionButtonStyle}" Padding="7,2" Content="P-Core" />
                                            <Button x:Name="TargetCore2Btn" Style="{StaticResource PillOptionButtonStyle}" Padding="7,2" Content="Prefer P" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Rectangle Height="1" Fill="#F1F5F9" />
                                <Grid Height="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Disable EcoQoS &amp; High I/O Priority" FontSize="11" Foreground="#09090B" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="ToggleTargetDeepBoost" Grid.Column="1" OnContent="" OffContent="" />
                                </Grid>
                                <Rectangle Height="1" Fill="#F1F5F9" />
                                <Grid Height="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Save Launch Policy (Registry)" FontSize="11" Foreground="#09090B" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="ToggleTargetIfeo" Grid.Column="1" OnContent="" OffContent="" />
                                </Grid>
                                <Rectangle Height="1" Fill="#F1F5F9" />
                                <Grid Height="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Boost Active Foreground Window" FontSize="11" Foreground="#09090B" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="ToggleFgBoost" Grid.Column="1" OnContent="" OffContent="" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Page 4: Support -->
                        <Grid x:Name="LeftPageCompat" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /></Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="CompatScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="5">
                                    <Grid Margin="0,0,0,2"><TextBlock Text="HARDWARE SUPPORT" FontSize="10" FontWeight="Bold" Foreground="#0F172A" /><TextBlock x:Name="CompatSummaryText" Text="0/0 Ready" FontSize="10" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" /></Grid>
                                    <StackPanel x:Name="CompatListPanel" Spacing="4" />
                                </StackPanel>
                            </ScrollViewer>
                            <Grid x:Name="CompatScrollTrack" Grid.Column="1" VerticalAlignment="Stretch" Margin="2,0,0,0">
                                <Border x:Name="CompatScrollThumb" Width="4" Height="40" CornerRadius="2" Background="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Top"><Border.RenderTransform><TranslateTransform x:Name="CompatScrollThumbTransform" /></Border.RenderTransform></Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Presets + Single Apply Button + Restore Below -->
                    <StackPanel Grid.Row="2" Spacing="5" Margin="0,5,0,0" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="PresetEcoBtn" Grid.Column="0" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryOutlineButtonStyle}" Height="24" Content="Eco" FontSize="10.5" FontWeight="SemiBold" />
                            <Button x:Name="PresetBalancedBtn" Grid.Column="2" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryOutlineButtonStyle}" Height="24" Content="Balanced" FontSize="10.5" FontWeight="SemiBold" />
                            <Button x:Name="PresetGamingBtn" Grid.Column="4" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryOutlineButtonStyle}" Height="24" Content="Performance" FontSize="10.5" FontWeight="SemiBold" />
                            <Button x:Name="PresetMaxOcBtn" Grid.Column="6" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryOutlineButtonStyle}" Height="24" Content="Max OC" FontSize="10.5" FontWeight="Bold" />
                        </Grid>
                        <Button x:Name="ApplyPresetsBtn" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryBlueButtonStyle}" Height="30">
                            <TextBlock Text="Apply Presets Settings" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        </Button>
                        <Button x:Name="RestoreBtn" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryOutlineButtonStyle}" Height="26">
                            <TextBlock Text="Restore" FontSize="11" FontWeight="SemiBold" Foreground="#09090B" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT PANE: Cores -->
            <Border x:Name="RightCoreBorder" Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="13,10">
                <Border.RenderTransform><TranslateTransform x:Name="RightPaneTransform" /></Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,7">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse x:Name="LiveTelemetryPulseDot" Width="7" Height="7" Fill="#2563EB" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="LiveDotScale" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <TextBlock Text="CORES" FontSize="10.5" FontWeight="Bold" Foreground="#09090B" VerticalAlignment="Center" />
                            <StackPanel x:Name="CoreLegendHybrid" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#2563EB" /><TextBlock Text="P-Core" FontSize="10" FontWeight="SemiBold" Foreground="#2563EB" /></StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#09090B" /><TextBlock Text="E-Core" FontSize="10" FontWeight="SemiBold" Foreground="#09090B" /></StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Border HorizontalAlignment="Right" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="2">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="FilterAllBtn" Style="{StaticResource PillOptionButtonStyle}" Padding="8,3" Content="All" />
                                <Button x:Name="FilterPCoreBtn" Style="{StaticResource PillOptionButtonStyle}" Padding="8,3" Content="P-Core" />
                                <Button x:Name="FilterECoreBtn" Style="{StaticResource PillOptionButtonStyle}" Padding="8,3" Content="E-Core" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="9" /></Grid.ColumnDefinitions>
                        <ScrollViewer x:Name="CoreGridScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <Grid x:Name="CoreGraphsContainer" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><TranslateTransform x:Name="CoreGridTransform" /></Grid.RenderTransform>
                            </Grid>
                        </ScrollViewer>
                        <Grid x:Name="CoreScrollTrack" Grid.Column="1" VerticalAlignment="Stretch" Margin="3,2,0,2">
                            <Border x:Name="CoreScrollThumb" Width="4" Height="48" CornerRadius="2" Background="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Top"><Border.RenderTransform><TranslateTransform x:Name="CoreScrollThumbTransform" /></Border.RenderTransform></Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- AMD Hardware Block Overlay -->
            <Border x:Name="AmdBlockOverlay" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#F7FFFFFF" CornerRadius="10" Padding="24">
                <Border Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="10" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#DC2626">
                                <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z M12 8v4 M12 16h.01" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="NON-INTEL / AMD CPU DETECTED — ACCESS BLOCKED" FontSize="14.5" FontWeight="Bold" Foreground="#991B1B" />
                                <TextBlock x:Name="AmdBlockVendorText" Text="Vendor: AuthenticAMD" FontSize="11" FontWeight="SemiBold" Foreground="#B91C1C" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="VOverclock Intel Beta only permits GenuineIntel processors. All sliders, VPower Intel Beta power plan creation, core tuning, and target optimization have been locked." FontSize="12" Foreground="#09090B" TextWrapping="Wrap" />
                        <Border Background="#FFFFFF" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <TextBlock x:Name="AmdBlockCpuNameText" Text="Detected CPU: --" FontSize="11.5" FontWeight="SemiBold" Foreground="#991B1B" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- Row 3: Clean Bottom Bar -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Button x:Name="SettingsButton" Style="{StaticResource MinimalIconButtonStyle}" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTipService.ToolTip="Settings">
                <Viewbox Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform><CompositeTransform x:Name="GearTransform" /></Viewbox.RenderTransform>
                    <Canvas Width="24" Height="24">
                        <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" Stroke="#0F172A" StrokeThickness="1.8" />
                        <Path Data="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.6.77 1 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
                              Stroke="#0F172A" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <TextBlock x:Name="ActionStatusText" Text="" FontSize="10.5" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.RenderTransform><TranslateTransform x:Name="ActionStatusTransform" /></TextBlock.RenderTransform>
            </TextBlock>

            <Button x:Name="MinimizeTrayButton" Style="{StaticResource MinimalIconButtonStyle}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ToolTip="Hide to Tray">
                <Viewbox Width="16" Height="16">
                    <Canvas Width="24" Height="24">
                        <Rectangle Canvas.Left="3" Canvas.Top="4" Width="18" Height="16" RadiusX="2" RadiusY="2" Stroke="#0F172A" StrokeThickness="1.8" />
                        <Path Data="M3 15h18 M10 9.5l2 2 2-2" Stroke="#0F172A" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>

        <!-- Custom Power Plan Dropdown Overlay -->
        <Grid x:Name="PowerPlanPopupHost" Grid.RowSpan="4" Visibility="Collapsed">
            <Grid x:Name="PowerPlanBackdrop" Background="#01000000" />
            <Border x:Name="PowerPlanPopupBorder"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,32,0,0"
                    Width="236"
                    MaxHeight="286"
                    Background="#FFFFFF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform><CompositeTransform x:Name="PowerPlanPopupTransform" /></Border.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PowerPlanPopupList" Spacing="3" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Running Process Picker Overlay (for Targets .exe Tab) -->
        <Grid x:Name="RunningProcPopupHost" Grid.RowSpan="4" Visibility="Collapsed">
            <Grid x:Name="RunningProcBackdrop" Background="#01000000" />
            <Border x:Name="RunningProcPopupBorder"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="98,150,0,0"
                    Width="320"
                    MaxHeight="244"
                    Background="#FFFFFF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform><CompositeTransform x:Name="RunningProcPopupTransform" /></Border.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RunningProcPopupList" Spacing="3" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>

    <!-- FULL-WIDTH SINGLE-COLUMN SETTINGS VIEW -->
    <Grid x:Name="SettingsView" Grid.Row="2" Padding="20,10,20,14" Visibility="Collapsed">
        <Grid.RenderTransform><CompositeTransform x:Name="SettingsTransform" /></Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Margin="0,0,0,10">
            <Grid x:Name="SettingsHeaderDragArea" Background="#01FFFFFF" />
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="BackButton" Style="{StaticResource MinimalIconButtonStyle}" Width="28" Height="28" ToolTipService.ToolTip="Back">
                    <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="M15 18L9 12L15 6" Stroke="#09090B" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
                </Button>
                <TextBlock Text="Settings" FontSize="14.5" FontWeight="Bold" Foreground="#09090B" VerticalAlignment="Center" IsHitTestVisible="False" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="0" VerticalAlignment="Top">
                <Grid Height="36"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Run at startup" FontSize="12.5" Foreground="#09090B" VerticalAlignment="Center" /><ToggleSwitch x:Name="ToggleAutoStart" Grid.Column="1" OnContent="" OffContent="" /></Grid>
                <Rectangle Height="1" Fill="#F1F5F9" />
                <Grid Height="36"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Start minimized" FontSize="12.5" Foreground="#09090B" VerticalAlignment="Center" /><ToggleSwitch x:Name="ToggleStartMinimized" Grid.Column="1" OnContent="" OffContent="" /></Grid>
                <Rectangle Height="1" Fill="#F1F5F9" />
                <Grid Height="36"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Minimize to tray" FontSize="12.5" Foreground="#09090B" VerticalAlignment="Center" /><ToggleSwitch x:Name="ToggleMinimizeToTray" Grid.Column="1" OnContent="" OffContent="" /></Grid>
                <Rectangle Height="1" Fill="#F1F5F9" />
                <Grid Height="36"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Close to tray" FontSize="12.5" Foreground="#09090B" VerticalAlignment="Center" /><ToggleSwitch x:Name="ToggleCloseToTray" Grid.Column="1" OnContent="" OffContent="" /></Grid>
                <Rectangle Height="1" Fill="#F1F5F9" />
                <Grid Height="38">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tray icon" FontSize="12.5" Foreground="#09090B" VerticalAlignment="Center" />
                    <Border Grid.Column="1" HorizontalAlignment="Right" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="TrayModeLogoBtn" Style="{StaticResource PillOptionButtonStyle}" Content="Icon" />
                            <Button x:Name="TrayModePercentBtn" Style="{StaticResource PillOptionButtonStyle}" Content="CPU %" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Rectangle Height="1" Fill="#F1F5F9" />
                <Grid Height="36"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Always on top" FontSize="12.5" Foreground="#09090B" VerticalAlignment="Center" /><ToggleSwitch x:Name="ToggleAlwaysOnTop" Grid.Column="1" OnContent="" OffContent="" /></Grid>
                <Rectangle Height="1" Fill="#F1F5F9" />
                <Grid Height="36"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Notifications" FontSize="12.5" Foreground="#09090B" VerticalAlignment="Center" /><ToggleSwitch x:Name="ToggleNotifications" Grid.Column="1" OnContent="" OffContent="" /></Grid>

                <TextBlock Text="PERFORMANCE &amp; AUTOMATION" FontSize="10" FontWeight="Bold" Foreground="#2563EB" Margin="0,12,0,4" />
                <Grid Height="36"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Auto-apply VPower on launch" FontSize="12.5" Foreground="#09090B" VerticalAlignment="Center" /><ToggleSwitch x:Name="ToggleApplyOnStart" Grid.Column="1" OnContent="" OffContent="" /></Grid>
                <Rectangle Height="1" Fill="#F1F5F9" />
                <Grid Height="36"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="0.5ms kernel timer" FontSize="12.5" Foreground="#09090B" VerticalAlignment="Center" /><ToggleSwitch x:Name="ToggleHighResTimer" Grid.Column="1" OnContent="" OffContent="" /></Grid>
                <Rectangle Height="1" Fill="#F1F5F9" />

                <Grid x:Name="SettingsElevateRow" Height="38">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Administrator mode" FontSize="12.5" Foreground="#09090B" VerticalAlignment="Center" />
                    <Button x:Name="SettingsElevateButton" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource MinimalIconButtonStyle}" BorderBrush="#CBD5E1" BorderThickness="1" Content="Elevate" FontSize="11.5" FontWeight="SemiBold" Foreground="#2563EB" Height="28" Padding="12,0" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <Grid Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,2">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="VOverclock Intel" FontSize="13.5" FontWeight="Bold" Foreground="#09090B" VerticalAlignment="Center" />
                        <TextBlock Text="Beta" FontSize="11.5" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Created by : @vinnotdkk" FontSize="11.5" Foreground="#475569" />
                </StackPanel>

                <Button x:Name="SupportDevButton" HorizontalAlignment="Right" Style="{StaticResource PrimaryBlueButtonStyle}" Height="34" Padding="14,0" CornerRadius="7" VerticalAlignment="Center" ToolTipService.ToolTip="https://sociabuzz.com/idnvinnmalay">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M12 21s-7-4.35-9.33-8.5C.67 8.92 2.92 4.5 7 4.5c2.04 0 3.74 1.07 5 2.7C13.26 5.57 14.96 4.5 17 4.5c4.08 0 6.33 4.42 4.33 8C19 16.65 12 21 12 21z" Fill="#FFFFFF" /></Canvas></Viewbox>
                        <TextBlock Text="Support Developer" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Grid>
